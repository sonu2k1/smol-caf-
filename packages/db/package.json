{
  "name": "@smol-cafe/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:seed:dry": "tsx scripts/seed-menu.ts",
    "db:seed:apply": "tsx scripts/seed-menu.ts --apply",
    "db:types": "supabase gen types typescript --local > src/types.ts",
    "db:diff": "supabase db diff -f",
    "db:push": "supabase db push",
    "db:status": "supabase status"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "supabase": "^2.15.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
